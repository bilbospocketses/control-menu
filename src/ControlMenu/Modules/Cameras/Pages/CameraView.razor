@page "/cameras/{CameraId}"
@using ControlMenu.Modules.Cameras.Entities
@using ControlMenu.Modules.Cameras.Services
@using ControlMenu.Services
@implements IDisposable

<PageTitle>@(_camera?.Name ?? "Camera") - Control Menu</PageTitle>

@if (_camera is null)
{
    <div class="camera-not-configured">
        <i class="bi bi-camera-video-off"></i>
        <h2>Camera not found</h2>
        <p>This camera may have been removed. See <a href="/settings/cameras">Settings &gt; Cameras</a>.</p>
    </div>
}
else if (!Go2Rtc.IsRunning)
{
    <div class="camera-not-configured">
        <i class="bi bi-exclamation-triangle"></i>
        <h2>Streaming service unavailable</h2>
        <p>go2rtc is not running. Check <a href="/settings/dependencies">Settings &gt; Dependencies</a>.</p>
    </div>
}
else
{
    <div class="camera-container">
        <iframe src="@($"{Go2Rtc.BaseUrl}/stream.html?src=camera-{_camera.Id:N}")" class="camera-iframe" allow="autoplay; fullscreen"></iframe>
    </div>
}

@code {
    [Parameter] public string CameraId { get; set; } = "";

    [Inject] private ICameraService CameraService { get; set; } = default!;
    [Inject] private IGo2RtcService Go2Rtc { get; set; } = default!;
    [Inject] private ICameraChangeNotifier CameraNotifier { get; set; } = default!;

    private Camera? _camera;

    protected override async Task OnInitializedAsync()
    {
        CameraNotifier.CamerasChanged += OnCamerasChanged;
        await RefreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (Guid.TryParse(CameraId, out var id))
        {
            _camera = await CameraService.GetAsync(id);
        }
        else
        {
            _camera = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnCamerasChanged() => _ = RefreshAsync();

    public void Dispose()
    {
        CameraNotifier.CamerasChanged -= OnCamerasChanged;
    }
}
