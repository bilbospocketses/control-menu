@page "/cameras/{Index:int}"
@using ControlMenu.Modules.Cameras.Services

<PageTitle>Camera @Index - Control Menu</PageTitle>

@if (!Go2Rtc.IsRunning)
{
    <div class="camera-not-configured">
        <i class="bi bi-exclamation-triangle"></i>
        <h2>Streaming service unavailable</h2>
        <p>go2rtc is not running. Check <a href="/settings/dependencies">Settings &gt; Dependencies</a>.</p>
    </div>
}
else
{
    <div class="camera-container">
        <iframe src="@($"{Go2Rtc.BaseUrl}/api/stream.mp4?src=camera-{Index}")" class="camera-iframe" allow="autoplay; fullscreen"></iframe>
    </div>
}

@code {
    [Parameter] public int Index { get; set; }
    [Inject] private IGo2RtcService Go2Rtc { get; set; } = default!;
}
