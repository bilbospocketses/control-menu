@page "/imaging/svg-rasterize"
@using ControlMenu.Modules.Imaging.Services
@using ControlMenu.Modules.Imaging.Services.Options
@inject IImageService Svc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>SVG Rasterize</PageTitle>

<h1><i class="bi bi-brush"></i> SVG Rasterize</h1>
<p class="page-subtitle">Render an SVG to a PNG raster or bundle multiple sizes into an ICO. Rendering happens in-process — no external tools required.</p>

<div class="converter-panel">
    <div class="form-group">
        <label class="form-label">Source SVG</label>
        @if (_hasFileSystemAccess)
        {
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <button class="btn btn-secondary" @onclick="PickFile">
                    <i class="bi bi-filetype-svg"></i> Select SVG
                </button>
                @if (!string.IsNullOrEmpty(_fileName))
                {
                    <span class="file-info">@_fileName (@ControlMenu.Services.FormatHelper.FormatSize(_fileBytes?.Length ?? 0))</span>
                }
            </div>
        }
        else
        {
            <input type="text" class="form-control" style="max-width:500px;"
                   placeholder="C:\path\to\image.svg"
                   @bind="_sourcePath" @bind:after="OnSourcePathChanged" />
            <div class="form-hint">File System Access API not available in this browser. Type the full path instead.</div>
        }
    </div>

    <div class="form-group">
        <label class="form-label">Output Format</label>
        <div class="mode-options">
            <label class="mode-radio">
                <input type="radio" name="outFormat" value="png"
                       checked="@(_format == "png")"
                       @onchange="@(() => _format = "png")" />
                PNG
            </label>
            <label class="mode-radio">
                <input type="radio" name="outFormat" value="ico"
                       checked="@(_format == "ico")"
                       @onchange="@(() => _format = "ico")" />
                ICO
            </label>
        </div>
        <div class="form-hint">
            @if (_format == "png")
            {
                <span>PNG renders at the largest selected size.</span>
            }
            else
            {
                <span>ICO bundles every selected size into one icon file.</span>
            }
        </div>
    </div>

    <div class="form-group">
        <label class="form-label">Sizes</label>
        <div class="size-options">
            @foreach (var size in _availableSizes)
            {
                <label class="size-checkbox">
                    <input type="checkbox" checked="@_selectedSizes.Contains(size)" @onchange="e => ToggleSize(size, (bool)e.Value!)" />
                    @(size)px
                </label>
            }
        </div>
    </div>

    <div class="form-group">
        <label class="form-label">Background</label>
        <label class="size-checkbox">
            <input type="checkbox" checked="@_transparent" @onchange="e => _transparent = (bool)e.Value!" />
            Transparent
        </label>
        @if (!_transparent)
        {
            <div style="margin-top:0.5rem; display:flex; align-items:center; gap:0.5rem;">
                <input type="color" class="color-input" value="@_bgColor" @oninput="e => _bgColor = e.Value?.ToString() ?? _bgColor" />
                <span class="info-line">@_bgColor</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-panel">
            <i class="bi bi-exclamation-triangle"></i> @_error
        </div>
    }

    @if (_rasterizing)
    {
        <div class="status-info">
            <i class="bi bi-arrow-repeat spin"></i> Rasterizing...
        </div>
    }

    <button class="btn btn-primary btn-lg" @onclick="Rasterize"
            disabled="@(!_canRasterize || _rasterizing || _selectedSizes.Count == 0)">
        <i class="bi bi-arrow-right-circle"></i> Rasterize
    </button>

    @if (_resultMessage is not null)
    {
        <div class="download-panel">
            <i class="bi bi-check-circle-fill" style="color:var(--success-color); font-size:1.2rem;"></i>
            <div>
                <strong>@_resultMessage</strong>
                @if (_savedPath is not null)
                {
                    <div style="margin-top:0.25rem; font-size:0.85rem; color:var(--text-secondary);">
                        Saved to: <code>@_savedPath</code>
                    </div>
                }
            </div>
            @if (_downloadUrl is not null)
            {
                <a href="@_downloadUrl" download="@_outFileName" class="btn-pill btn-pill-success">
                    <i class="bi bi-download"></i> Download Copy
                </a>
            }
        </div>
    }
</div>

@code {
    private readonly int[] _availableSizes = [16, 32, 48, 64, 128, 256, 512];
    private HashSet<int> _selectedSizes = [256];
    private string _format = "png";
    private bool _transparent = true;
    private string _bgColor = "#ffffff";

    private bool _rasterizing;
    private string? _error;
    private string? _resultMessage;
    private string? _savedPath;
    private string? _downloadUrl;
    // Tracks the current /temp download copy so each new output replaces the prior one instead of
    // accumulating, and so Dispose can delete it on navigate-away rather than waiting on the timer.
    private string? _downloadWebCopyPath;
    private string? _outFileName;

    // File System Access API mode
    private bool _hasFileSystemAccess;
    private string? _fileName;
    private byte[]? _fileBytes;

    // Fallback path mode
    private string _sourcePath = "";

    private bool _canRasterize => _fileBytes is not null || !string.IsNullOrWhiteSpace(_sourcePath);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasFileSystemAccess = await JS.InvokeAsync<bool>("hasFileSystemAccess");
            StateHasChanged();
        }
    }

    private async Task PickFile()
    {
        _resultMessage = null;
        DeleteDownloadWebCopy();
        _savedPath = null;
        _error = null;

        try
        {
            var result = await JS.InvokeAsync<FilePickerResult?>("filePickerOpen", ".svg");
            if (result is null) return;

            _fileName = result.Name;
            _fileBytes = System.Convert.FromBase64String(result.BytesBase64);
        }
        catch (Exception ex)
        {
            _error = $"Could not read selected file: {ex.Message}";
        }
    }

    private async Task OnSourcePathChanged()
    {
        _resultMessage = null;
        DeleteDownloadWebCopy();
        _savedPath = null;
        _error = null;

        var source = _sourcePath.Trim();
        if (string.IsNullOrWhiteSpace(source) || !File.Exists(source)) return;

        // Path mode reads bytes lazily at rasterize time; just clear stale state here.
        await Task.CompletedTask;
    }

    private void ToggleSize(int size, bool selected)
    {
        if (selected) _selectedSizes.Add(size);
        else _selectedSizes.Remove(size);
    }

    private async Task Rasterize()
    {
        if (_selectedSizes.Count == 0) return;

        _rasterizing = true;
        _resultMessage = null;
        _savedPath = null;
        DeleteDownloadWebCopy();
        _error = null;

        try
        {
            var sizes = _selectedSizes.OrderBy(s => s).ToArray();
            var background = _transparent ? "transparent" : _bgColor;
            var ext = _format; // "png" or "ico"
            var options = new RasterizeOptions
            {
                Sizes = sizes,
                OutputFormat = _format,
                Background = background
            };

            if (_fileBytes is not null)
            {
                // File System Access API mode — rasterize in memory, save via browser.
                var baseName = Path.GetFileNameWithoutExtension(_fileName ?? "image");
                _outFileName = $"{baseName}.{ext}";

                var outBytes = await Svc.RasterizeSvgAsync(_fileBytes, options);
                var base64 = System.Convert.ToBase64String(outBytes);
                var savedName = await JS.InvokeAsync<string?>("filePickerSaveAs", _outFileName, base64);

                if (savedName is not null)
                {
                    _resultMessage = "SVG rasterized successfully.";
                    _savedPath = savedName;
                    SetDownloadWebCopy(outBytes, ext);
                }
                else
                {
                    _error = "Save cancelled.";
                }
            }
            else if (!string.IsNullOrWhiteSpace(_sourcePath))
            {
                // Fallback path mode — read bytes, rasterize in memory, write bytes back to disk.
                var source = _sourcePath.Trim();
                if (!File.Exists(source))
                {
                    _error = $"File not found: {source}";
                    return;
                }

                var sourceDir = Path.GetDirectoryName(source)!;
                var baseName = Path.GetFileNameWithoutExtension(source);
                _outFileName = $"{baseName}.{ext}";
                var targetPath = Path.Combine(sourceDir, _outFileName);

                var sourceBytes = await File.ReadAllBytesAsync(source);
                var outBytes = await Svc.RasterizeSvgAsync(sourceBytes, options);
                await File.WriteAllBytesAsync(targetPath, outBytes);
                _resultMessage = "SVG rasterized successfully.";
                _savedPath = targetPath;
                SetDownloadWebCopy(outBytes, ext);
            }
        }
        catch (ImagingException ex)
        {
            // Invalid / unparseable SVG surfaces here.
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Rasterize failed: {ex.Message}";
        }
        finally
        {
            _rasterizing = false;
        }
    }

    /// <summary>
    /// Publishes <paramref name="bytes"/> as the current download copy via a /temp web-copy,
    /// replacing any prior copy so they don't accumulate.
    /// </summary>
    private void SetDownloadWebCopy(byte[] bytes, string ext)
    {
        DeleteDownloadWebCopy();
        _downloadWebCopyPath = PublishWebCopy(bytes, ext, out var url);
        _downloadUrl = url;
    }

    /// <summary>
    /// Writes <paramref name="bytes"/> to a GUID-named file under wwwroot/temp and returns the
    /// public URL via <paramref name="url"/>, scheduling a best-effort delete after 5 minutes.
    /// Returns the on-disk path so the caller can replace/track the current web copy.
    /// </summary>
    private string PublishWebCopy(byte[] bytes, string ext, out string url)
    {
        var tempDir = Path.Combine(Env.WebRootPath, "temp");
        Directory.CreateDirectory(tempDir);
        var webCopy = Path.Combine(tempDir, $"{Guid.NewGuid():N}.{ext}");
        File.WriteAllBytes(webCopy, bytes);
        url = $"/temp/{Path.GetFileName(webCopy)}";

        // Backstop sweep for a copy the page never got to delete itself. Tied to the component
        // lifetime so navigating away cancels it, rather than leaving one live 5-minute timer per
        // conversion holding onto the path; Dispose deletes the current copy eagerly regardless.
        _ = Task.Delay(TimeSpan.FromMinutes(5), _lifetime.Token).ContinueWith(_ =>
        {
            try { if (File.Exists(webCopy)) File.Delete(webCopy); } catch { }
        }, TaskContinuationOptions.OnlyOnRanToCompletion);

        return webCopy;
    }

    private void DeleteDownloadWebCopy()
    {
        if (_downloadWebCopyPath is not null)
        {
            try { if (File.Exists(_downloadWebCopyPath)) File.Delete(_downloadWebCopyPath); } catch { }
            _downloadWebCopyPath = null;
        }
        _downloadUrl = null;
    }

    // Delete this page's /temp download copy on teardown (navigate-away), rather than leaving it
    // for the 5-minute fallback timer. No-ops when nothing is tracked.
    // Cancelled on Dispose; bounds the backstop sweep timers to the component's lifetime.
    private readonly CancellationTokenSource _lifetime = new();

    public void Dispose()
    {
        DeleteDownloadWebCopy();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private record FilePickerResult(string Name, string BytesBase64);
}
