@page "/imaging/image-resize"
@using ControlMenu.Modules.Imaging.Services
@using ControlMenu.Modules.Imaging.Services.Options
@inject IImageService Svc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Image Resize</PageTitle>

<h1><i class="bi bi-aspect-ratio"></i> Image Resize</h1>
<p class="page-subtitle">Resize an image by pixel dimensions, a percentage, or a maximum dimension. The output keeps the source format.</p>

<div class="converter-panel">
    <div class="form-group">
        <label class="form-label">Source Image</label>
        @if (_hasFileSystemAccess)
        {
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <button class="btn btn-secondary" @onclick="PickFile">
                    <i class="bi bi-file-earmark-image"></i> Select Image
                </button>
                @if (!string.IsNullOrEmpty(_fileName))
                {
                    <span class="file-info">@_fileName (@ControlMenu.Services.FormatHelper.FormatSize(_fileBytes?.Length ?? 0))</span>
                }
            </div>
        }
        else
        {
            <input type="text" class="form-control" style="max-width:500px;"
                   placeholder="C:\path\to\image.png"
                   @bind="_sourcePath" @bind:after="OnSourcePathChanged" />
            <div class="form-hint">File System Access API not available in this browser. Type the full path instead.</div>
        }
    </div>

    @if (_sourceInfo is not null)
    {
        <div class="form-group">
            <label class="form-label">Original Dimensions</label>
            <div class="info-line">
                <strong>@_sourceInfo.Width × @_sourceInfo.Height px</strong>
                &nbsp;·&nbsp; @_sourceInfo.Format
                &nbsp;·&nbsp; @ControlMenu.Services.FormatHelper.FormatSize(_sourceInfo.SizeBytes)
            </div>
        </div>
    }

    <div class="form-group">
        <label class="form-label">Resize Mode</label>
        <div class="mode-options">
            <label class="mode-radio">
                <input type="radio" name="resizeMode" value="@ResizeMode.PixelDimensions"
                       checked="@(_mode == ResizeMode.PixelDimensions)"
                       @onchange="() => _mode = ResizeMode.PixelDimensions" />
                Pixel dimensions
            </label>
            <label class="mode-radio">
                <input type="radio" name="resizeMode" value="@ResizeMode.Percentage"
                       checked="@(_mode == ResizeMode.Percentage)"
                       @onchange="() => _mode = ResizeMode.Percentage" />
                Percentage
            </label>
            <label class="mode-radio">
                <input type="radio" name="resizeMode" value="@ResizeMode.MaxDimensionFit"
                       checked="@(_mode == ResizeMode.MaxDimensionFit)"
                       @onchange="() => _mode = ResizeMode.MaxDimensionFit" />
                Max dimension fit
            </label>
        </div>
    </div>

    @if (_mode == ResizeMode.PixelDimensions)
    {
        <div class="form-group">
            <div class="dimension-inputs">
                <div>
                    <label class="form-label">Width (px)</label>
                    <input type="number" min="1" class="form-control" style="max-width:140px;" @bind="_width" />
                </div>
                <div>
                    <label class="form-label">Height (px)</label>
                    <input type="number" min="1" class="form-control" style="max-width:140px;" @bind="_height" />
                </div>
            </div>
            <label class="mode-radio" style="margin-top:0.5rem;">
                <input type="checkbox" checked="@_lockAspect" @onchange="e => _lockAspect = (bool)e.Value!" />
                Lock aspect ratio
            </label>
            <div class="form-hint">With aspect locked, set just one of width or height; the other scales automatically.</div>
        </div>
    }
    else if (_mode == ResizeMode.Percentage)
    {
        <div class="form-group">
            <label class="form-label">Percentage (%)</label>
            <input type="number" min="1" max="1000" step="1" class="form-control" style="max-width:140px;" @bind="_percentage" />
        </div>
    }
    else
    {
        <div class="form-group">
            <label class="form-label">Max dimension (px)</label>
            <input type="number" min="1" class="form-control" style="max-width:140px;" @bind="_maxDimension" />
            <div class="form-hint">The longer side is scaled down to this size; aspect ratio is preserved.</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-panel">
            <i class="bi bi-exclamation-triangle"></i> @_error
        </div>
    }

    @if (_resizing)
    {
        <div class="status-info">
            <i class="bi bi-arrow-repeat spin"></i> Resizing...
        </div>
    }

    <button class="btn btn-primary btn-lg" @onclick="Resize"
            disabled="@(!_canResize || _resizing)">
        <i class="bi bi-arrow-right-circle"></i> Resize
    </button>

    @if (_resultMessage is not null)
    {
        <div class="download-panel">
            <i class="bi bi-check-circle-fill" style="color:var(--success-color); font-size:1.2rem;"></i>
            <div>
                <strong>@_resultMessage</strong>
                @if (_savedPath is not null)
                {
                    <div style="margin-top:0.25rem; font-size:0.85rem; color:var(--text-secondary);">
                        Saved to: <code>@_savedPath</code>
                    </div>
                }
            </div>
            @if (_downloadUrl is not null)
            {
                <a href="@_downloadUrl" download="@_outFileName" class="btn-pill btn-pill-success">
                    <i class="bi bi-download"></i> Download Copy
                </a>
            }
        </div>
    }
</div>

@code {
    private ResizeMode _mode = ResizeMode.PixelDimensions;
    private int? _width;
    private int? _height;
    private bool _lockAspect = true;
    private double? _percentage = 50;
    private int? _maxDimension = 1024;

    private bool _resizing;
    private string? _error;
    private string? _resultMessage;
    private string? _savedPath;
    private string? _downloadUrl;
    private string? _outFileName;
    private ImageInfo? _sourceInfo;

    // File System Access API mode
    private bool _hasFileSystemAccess;
    private string? _fileName;
    private byte[]? _fileBytes;

    // Fallback path mode
    private string _sourcePath = "";

    private bool _canResize => _fileBytes is not null || !string.IsNullOrWhiteSpace(_sourcePath);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasFileSystemAccess = await JS.InvokeAsync<bool>("hasFileSystemAccess");
            StateHasChanged();
        }
    }

    private async Task PickFile()
    {
        _resultMessage = null;
        _downloadUrl = null;
        _savedPath = null;
        _error = null;
        _sourceInfo = null;

        try
        {
            var result = await JS.InvokeAsync<FilePickerResult?>("filePickerOpen", ".png,.jpg,.jpeg,.bmp,.gif,.webp,.tiff,.tif,.avif");
            if (result is null) return;

            _fileName = result.Name;
            _fileBytes = System.Convert.FromBase64String(result.BytesBase64);

            await LoadInfoAsync(_fileBytes);
        }
        catch (Exception ex)
        {
            _error = $"Could not read selected file: {ex.Message}";
        }
    }

    private async Task OnSourcePathChanged()
    {
        _resultMessage = null;
        _downloadUrl = null;
        _savedPath = null;
        _error = null;
        _sourceInfo = null;

        var source = _sourcePath.Trim();
        if (string.IsNullOrWhiteSpace(source) || !File.Exists(source)) return;

        try
        {
            var bytes = await File.ReadAllBytesAsync(source);
            await LoadInfoAsync(bytes);
        }
        catch (Exception ex)
        {
            _error = $"Could not read image info: {ex.Message}";
        }
    }

    private async Task LoadInfoAsync(byte[] bytes)
    {
        try
        {
            _sourceInfo = await Svc.GetInfoAsync(bytes);
        }
        catch (Exception ex)
        {
            _error = $"Could not read image info: {ex.Message}";
        }
    }

    private ResizeOptions BuildOptions() => _mode switch
    {
        ResizeMode.PixelDimensions => new ResizeOptions
        {
            Mode = ResizeMode.PixelDimensions,
            Width = _width,
            Height = _height,
            LockAspect = _lockAspect
        },
        ResizeMode.Percentage => new ResizeOptions
        {
            Mode = ResizeMode.Percentage,
            Percentage = _percentage
        },
        _ => new ResizeOptions
        {
            Mode = ResizeMode.MaxDimensionFit,
            MaxDimension = _maxDimension
        }
    };

    private string? ValidateInputs() => _mode switch
    {
        ResizeMode.PixelDimensions when _width is null && _height is null
            => "Enter a width, a height, or both.",
        ResizeMode.Percentage when _percentage is null or <= 0
            => "Enter a percentage greater than zero.",
        ResizeMode.MaxDimensionFit when _maxDimension is null or <= 0
            => "Enter a maximum dimension greater than zero.",
        _ => null
    };

    private async Task Resize()
    {
        _resizing = true;
        _resultMessage = null;
        _savedPath = null;
        _downloadUrl = null;
        _error = null;

        try
        {
            var validationError = ValidateInputs();
            if (validationError is not null)
            {
                _error = validationError;
                return;
            }

            var options = BuildOptions();

            if (_fileBytes is not null)
            {
                // File System Access API mode — resize in memory, save via browser.
                // Output preserves the input format (the service does this); derive the
                // extension from the source filename.
                var baseName = Path.GetFileNameWithoutExtension(_fileName ?? "image");
                var ext = NormalizeExt(Path.GetExtension(_fileName) , _sourceInfo?.Format);
                _outFileName = $"{baseName}-resized{ext}";

                var outBytes = await Svc.ResizeAsync(_fileBytes, options);
                var base64 = System.Convert.ToBase64String(outBytes);
                var savedName = await JS.InvokeAsync<string?>("filePickerSaveAs", _outFileName, base64);

                if (savedName is not null)
                {
                    _resultMessage = "Image resized successfully.";
                    _savedPath = savedName;
                    PublishWebCopy(outBytes, ext.TrimStart('.'));
                }
                else
                {
                    _error = "Save cancelled.";
                }
            }
            else if (!string.IsNullOrWhiteSpace(_sourcePath))
            {
                // Fallback path mode — read bytes, resize in memory, write bytes back to disk.
                var source = _sourcePath.Trim();
                if (!File.Exists(source))
                {
                    _error = $"File not found: {source}";
                    return;
                }

                var sourceDir = Path.GetDirectoryName(source)!;
                var baseName = Path.GetFileNameWithoutExtension(source);
                var ext = NormalizeExt(Path.GetExtension(source), _sourceInfo?.Format);
                _outFileName = $"{baseName}-resized{ext}";
                var targetPath = Path.Combine(sourceDir, _outFileName);

                var sourceBytes = await File.ReadAllBytesAsync(source);
                var outBytes = await Svc.ResizeAsync(sourceBytes, options);
                await File.WriteAllBytesAsync(targetPath, outBytes);
                _resultMessage = "Image resized successfully.";
                _savedPath = targetPath;
                PublishWebCopy(outBytes, ext.TrimStart('.'));
            }
        }
        catch (Exception ex)
        {
            _error = $"Resize failed: {ex.Message}";
        }
        finally
        {
            _resizing = false;
        }
    }

    /// <summary>
    /// Returns a dotted extension for the output filename. Prefers the source file's own
    /// extension; falls back to the detected format when there is no extension (e.g. a
    /// path typed without one or an in-memory image).
    /// </summary>
    private static string NormalizeExt(string? sourceExtension, string? detectedFormat)
    {
        if (!string.IsNullOrWhiteSpace(sourceExtension))
            return sourceExtension.ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(detectedFormat))
            return "." + detectedFormat.ToLowerInvariant();
        return ".png";
    }

    // Tracks the current /temp web-copy so a re-convert replaces it (no accumulation) and Dispose
    // removes it on navigate-away, instead of relying solely on the 5-minute fallback timer.
    private string? _webCopyPath;

    private void PublishWebCopy(byte[] bytes, string ext)
    {
        var safeExt = string.IsNullOrWhiteSpace(ext) ? "png" : ext;
        var tempDir = Path.Combine(Env.WebRootPath, "temp");
        Directory.CreateDirectory(tempDir);
        DeleteWebCopy();
        var webCopy = Path.Combine(tempDir, $"{Guid.NewGuid():N}.{safeExt}");
        File.WriteAllBytes(webCopy, bytes);
        _webCopyPath = webCopy;
        _downloadUrl = $"/temp/{Path.GetFileName(webCopy)}";

        _ = Task.Delay(TimeSpan.FromMinutes(5)).ContinueWith(_ =>
        {
            try { if (File.Exists(webCopy)) File.Delete(webCopy); } catch { }
        });
    }

    private void DeleteWebCopy()
    {
        if (_webCopyPath is not null)
        {
            try { if (File.Exists(_webCopyPath)) File.Delete(_webCopyPath); } catch { }
            _webCopyPath = null;
        }
    }

    public void Dispose() => DeleteWebCopy();

    private record FilePickerResult(string Name, string BytesBase64);
}
