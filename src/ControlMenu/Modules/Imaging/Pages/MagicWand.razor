@page "/imaging/magic-wand"
@using ControlMenu.Modules.Imaging.Services
@using ControlMenu.Modules.Imaging.Services.Options
@inject IImageService Svc
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>Magic Wand</PageTitle>

<h1><i class="bi bi-magic"></i> Magic Wand</h1>
<p class="page-subtitle">Click a background pixel to seed the removal, tune the tolerance to preview the result live, then Apply to render it authoritatively and Save. Supported formats: PNG, JPG, JPEG, BMP, GIF, WEBP, TIFF.</p>

<div class="converter-panel">
    <div class="form-group">
        <label class="form-label">Source Image</label>
        @if (_hasFileSystemAccess)
        {
            <div style="display:flex; gap:0.5rem; align-items:center;">
                <button class="btn btn-secondary" @onclick="PickFile">
                    <i class="bi bi-file-earmark-image"></i> Select Image
                </button>
                @if (!string.IsNullOrEmpty(_fileName))
                {
                    <span class="file-info">@_fileName (@ControlMenu.Services.FormatHelper.FormatSize(_fileBytes?.Length ?? 0))</span>
                }
            </div>
        }
        else
        {
            <input type="text" class="form-control" style="max-width:500px;"
                   placeholder="C:\path\to\image.png"
                   @bind="_sourcePath" @bind:after="OnSourcePathChanged" />
            <div class="form-hint">File System Access API not available in this browser. Type the full path instead.</div>
        }
    </div>

    @if (_sourceInfo is not null && _imageUrl is not null)
    {
        <div class="form-group">
            <label class="form-label">Image — click a background pixel to seed</label>
            <div class="info-line" style="margin-bottom:0.5rem;">
                @_sourceInfo.Width × @_sourceInfo.Height px
                @if (_seedX is not null)
                {
                    <span>&nbsp;·&nbsp; seed at <strong>(@_seedX, @_seedY)</strong></span>
                }
                else
                {
                    <span>&nbsp;·&nbsp; no seed set</span>
                }
            </div>

            @* The preview swaps in for the source once a seed is set; the checkerboard makes
               transparency visible. The marker dot sits over the click point in display coords. *@
            <div class="wand-stage checker" style="position:relative; max-width:@(DisplayMaxWidth)px;">
                <img src="@(_previewUrl ?? _imageUrl)" id="@ImgElementId"
                     class="wand-image"
                     style="display:block; width:100%; height:auto; cursor:crosshair;"
                     @onclick="OnImageClick" />
                @if (_seedX is not null)
                {
                    <div class="seed-marker"
                         style="left:@(_markerLeftPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%; top:@(_markerTopPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                }
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Tolerance: @_tolerance%</label>
            <input type="range" min="0" max="100" step="1" class="tolerance-slider"
                   value="@_tolerance" @oninput="OnToleranceChanged" />
            <div class="form-hint">How close a pixel's colour must be to the seed to be removed. Higher = more aggressive.</div>
        </div>

        <div class="form-group">
            <label class="size-checkbox">
                <input type="checkbox" checked="@_contiguous" @onchange="OnContiguousChanged" />
                Contiguous (only the region connected to the seed)
            </label>
            <div class="form-hint">Unchecked = remove every matching colour anywhere in the image.</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-panel">
            <i class="bi bi-exclamation-triangle"></i> @_error
        </div>
    }

    @if (_applying)
    {
        <div class="status-info">
            <i class="bi bi-arrow-repeat spin"></i> Rendering with ImageMagick...
        </div>
    }

    @if (_sourceInfo is not null)
    {
        <button class="btn btn-primary btn-lg" @onclick="Apply"
                disabled="@(_seedX is null || _applying)">
            <i class="bi bi-magic"></i> Apply &amp; Save
        </button>
        @if (_seedX is null)
        {
            <div class="form-hint">Click a pixel in the image above to enable Apply.</div>
        }
    }

    @if (_resultMessage is not null)
    {
        <div class="download-panel">
            <i class="bi bi-check-circle-fill" style="color:var(--success-color); font-size:1.2rem;"></i>
            <div>
                <strong>@_resultMessage</strong>
                @if (_savedPath is not null)
                {
                    <div style="margin-top:0.25rem; font-size:0.85rem; color:var(--text-secondary);">
                        Saved to: <code>@_savedPath</code>
                    </div>
                }
            </div>
            @if (_downloadUrl is not null)
            {
                <a href="@_downloadUrl" download="@_outFileName" class="btn-pill btn-pill-success">
                    <i class="bi bi-download"></i> Download Copy
                </a>
            }
        </div>
    }
</div>

@code {
    // A fixed display width keeps the rendered image stable; the click→source mapping reads the
    // ACTUAL rendered size from JS each click, so this constant is only a layout cap, not the
    // basis of the coordinate math.
    private const int DisplayMaxWidth = 600;
    private const string ImgElementId = "wand-source-img";

    private bool _applying;
    private string? _error;
    private string? _resultMessage;
    private string? _savedPath;
    private string? _downloadUrl;
    private string? _outFileName;
    private ImageInfo? _sourceInfo;

    // File System Access API mode
    private bool _hasFileSystemAccess;
    private string? _fileName;
    private byte[]? _fileBytes;

    // Fallback path mode
    private string _sourcePath = "";

    // Source displayed via a temp web-copy URL (so the rendered <img> maps to source pixels).
    private string? _imageUrl;
    private string? _imageWebCopyPath;

    // Live preview (data URL of the in-process SkiaSharp flood-fill, downscaled internally).
    private string? _previewUrl;

    // Seed in SOURCE pixel coordinates; marker position as a percentage of the displayed image.
    private int? _seedX;
    private int? _seedY;
    private double _markerLeftPct;
    private double _markerTopPct;

    private int _tolerance = 15;
    private bool _contiguous = true;

    // Debounce slider drags so we don't flood the circuit with a preview render per integer step.
    private CancellationTokenSource? _previewDebounceCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hasFileSystemAccess = await JS.InvokeAsync<bool>("hasFileSystemAccess");
            StateHasChanged();
        }
    }

    private async Task PickFile()
    {
        ResetResult();
        ResetSeedAndPreview();
        _sourceInfo = null;
        ClearImageWebCopy();

        try
        {
            var result = await JS.InvokeAsync<FilePickerResult?>("filePickerOpen", ".png,.jpg,.jpeg,.bmp,.gif,.webp,.tiff,.tif");
            if (result is null) return;

            _fileName = result.Name;
            _fileBytes = System.Convert.FromBase64String(result.BytesBase64);

            await LoadSourceAsync(_fileBytes);
        }
        catch (Exception ex)
        {
            _error = $"Could not read selected file: {ex.Message}";
        }
    }

    private async Task OnSourcePathChanged()
    {
        ResetResult();
        ResetSeedAndPreview();
        _sourceInfo = null;
        ClearImageWebCopy();

        var source = _sourcePath.Trim();
        if (string.IsNullOrWhiteSpace(source) || !File.Exists(source)) return;

        try
        {
            _fileName = Path.GetFileName(source);
            _fileBytes = await File.ReadAllBytesAsync(source);
            await LoadSourceAsync(_fileBytes);
        }
        catch (Exception ex)
        {
            _error = $"Could not read image: {ex.Message}";
        }
    }

    private async Task LoadSourceAsync(byte[] bytes)
    {
        try
        {
            _sourceInfo = await Svc.GetInfoAsync(bytes);
            // Publish a temp web-copy of the ORIGINAL so the browser can render it for clicking.
            var ext = (_sourceInfo.Format ?? "png").ToLowerInvariant();
            _imageWebCopyPath = PublishWebCopy(bytes, ext, out var url);
            _imageUrl = url;
        }
        catch (Exception ex)
        {
            _error = $"Could not read image info: {ex.Message}";
        }
    }

    /// <summary>
    /// Map a click on the rendered image to a SOURCE pixel. OffsetX/OffsetY are the click position
    /// within the element's content box (display coords). We read the element's ACTUAL natural and
    /// rendered size from JS (getElementRect) and scale: sourceX = OffsetX * naturalW / renderedW.
    /// The seed is clamped to [0, W-1] × [0, H-1]. We also stash the marker position as a percentage
    /// of the rendered size so the marker stays put regardless of responsive resizing.
    /// </summary>
    private async Task OnImageClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (_sourceInfo is null || _fileBytes is null) return;

        try
        {
            var rect = await JS.InvokeAsync<ElementRect?>("getElementRect", ImgElementId);
            if (rect is null || rect.RenderedWidth <= 0 || rect.RenderedHeight <= 0) return;

            // Prefer the image's intrinsic natural size; fall back to the known source dimensions.
            var naturalW = rect.NaturalWidth > 0 ? rect.NaturalWidth : _sourceInfo.Width;
            var naturalH = rect.NaturalHeight > 0 ? rect.NaturalHeight : _sourceInfo.Height;

            var scaleX = naturalW / rect.RenderedWidth;
            var scaleY = naturalH / rect.RenderedHeight;

            var sx = (int)Math.Round(e.OffsetX * scaleX);
            var sy = (int)Math.Round(e.OffsetY * scaleY);

            _seedX = Math.Clamp(sx, 0, _sourceInfo.Width - 1);
            _seedY = Math.Clamp(sy, 0, _sourceInfo.Height - 1);

            // Marker as a percentage of the rendered box (robust to later responsive resizes).
            _markerLeftPct = Math.Clamp(e.OffsetX / rect.RenderedWidth * 100.0, 0, 100);
            _markerTopPct = Math.Clamp(e.OffsetY / rect.RenderedHeight * 100.0, 0, 100);

            // A fresh seed invalidates any prior Apply result.
            ResetResult();
            await RenderPreviewAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not register click: {ex.Message}";
        }
    }

    private async Task OnToleranceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var t))
            _tolerance = Math.Clamp(t, 0, 100);

        ResetResult();
        await DebouncedPreviewAsync();
    }

    private async Task OnContiguousChanged(ChangeEventArgs e)
    {
        _contiguous = e.Value is bool b && b;
        ResetResult();
        await RenderPreviewAsync();
    }

    /// <summary>Debounce preview renders during a slider drag so each integer step doesn't render.</summary>
    private async Task DebouncedPreviewAsync()
    {
        _previewDebounceCts?.Cancel();
        _previewDebounceCts = new CancellationTokenSource();
        var token = _previewDebounceCts.Token;
        try
        {
            await Task.Delay(120, token);
            if (token.IsCancellationRequested) return;
            await RenderPreviewAsync();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer change — nothing to do.
        }
    }

    /// <summary>
    /// Run the in-process SkiaSharp flood-fill preview. The engine downscales a copy internally
    /// (longest side capped) so this stays responsive; the seed/tolerance still map to the full-res
    /// authoritative Apply. Heavy pixel work runs off the render thread via Task.Run.
    /// </summary>
    private async Task RenderPreviewAsync()
    {
        if (_fileBytes is null || _seedX is null || _seedY is null) return;

        try
        {
            var bytes = _fileBytes;
            var seedX = _seedX.Value;
            var seedY = _seedY.Value;
            var tol = _tolerance;
            var contig = _contiguous;

            var pngBytes = await Task.Run(() =>
                FloodFillPreviewEngine.RenderPreviewPng(bytes, seedX, seedY, tol, contig));

            _previewUrl = $"data:image/png;base64,{System.Convert.ToBase64String(pngBytes)}";
            _error = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Preview failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Authoritative removal: hand the FULL-RES source bytes + source-space seed to magick
    /// (RemoveBackgroundAsync), then save the magick PNG via the native picker and publish a
    /// download copy. The live preview only approximates; THESE bytes are what the user keeps.
    /// </summary>
    private async Task Apply()
    {
        if (_fileBytes is null || _seedX is null || _seedY is null) return;

        _applying = true;
        ResetResult();
        _error = null;

        try
        {
            var options = new BackgroundRemoveOptions
            {
                SeedX = _seedX.Value,
                SeedY = _seedY.Value,
                Tolerance = _tolerance,
                Contiguous = _contiguous
            };

            var outBytes = await Svc.RemoveBackgroundAsync(_fileBytes, options);

            var baseName = Path.GetFileNameWithoutExtension(_fileName ?? "image");
            _outFileName = $"{baseName}-nobg.png"; // background removal always yields a PNG (alpha)

            if (_hasFileSystemAccess)
            {
                var base64 = System.Convert.ToBase64String(outBytes);
                var savedName = await JS.InvokeAsync<string?>("filePickerSaveAs", _outFileName, base64);
                if (savedName is not null)
                {
                    _resultMessage = "Background removed successfully.";
                    _savedPath = savedName;
                    _imageWebCopyPath = PublishWebCopy(outBytes, "png", out var url);
                    _downloadUrl = url;
                    // Show the authoritative magick result in the stage.
                    _previewUrl = $"data:image/png;base64,{base64}";
                }
                else
                {
                    _error = "Save cancelled.";
                }
            }
            else if (!string.IsNullOrWhiteSpace(_sourcePath))
            {
                var source = _sourcePath.Trim();
                var sourceDir = Path.GetDirectoryName(source)!;
                var targetPath = Path.Combine(sourceDir, _outFileName);
                await File.WriteAllBytesAsync(targetPath, outBytes);
                _resultMessage = "Background removed successfully.";
                _savedPath = targetPath;
                _imageWebCopyPath = PublishWebCopy(outBytes, "png", out var url);
                _downloadUrl = url;
                _previewUrl = $"data:image/png;base64,{System.Convert.ToBase64String(outBytes)}";
            }
        }
        catch (ArgumentException ex)
        {
            _error = $"Could not remove background: {ex.Message}";
        }
        catch (ImagingException ex)
        {
            _error = $"Could not remove background: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Apply failed: {ex.Message}";
        }
        finally
        {
            _applying = false;
        }
    }

    /// <summary>
    /// Writes <paramref name="bytes"/> to a GUID-named file under wwwroot/temp and returns the
    /// public URL via <paramref name="url"/>, scheduling a best-effort delete after 5 minutes.
    /// Returns the on-disk path so the caller can replace/track the current web copy.
    /// </summary>
    private string PublishWebCopy(byte[] bytes, string ext, out string url)
    {
        var tempDir = Path.Combine(Env.WebRootPath, "temp");
        Directory.CreateDirectory(tempDir);
        var webCopy = Path.Combine(tempDir, $"{Guid.NewGuid():N}.{ext}");
        File.WriteAllBytes(webCopy, bytes);
        url = $"/temp/{Path.GetFileName(webCopy)}";

        _ = Task.Delay(TimeSpan.FromMinutes(5)).ContinueWith(_ =>
        {
            try { if (File.Exists(webCopy)) File.Delete(webCopy); } catch { }
        });

        return webCopy;
    }

    private void ClearImageWebCopy()
    {
        if (_imageWebCopyPath is not null)
        {
            try { if (File.Exists(_imageWebCopyPath)) File.Delete(_imageWebCopyPath); } catch { }
            _imageWebCopyPath = null;
        }
        _imageUrl = null;
    }

    private void ResetResult()
    {
        _resultMessage = null;
        _savedPath = null;
        _downloadUrl = null;
        _outFileName = null;
    }

    private void ResetSeedAndPreview()
    {
        _seedX = null;
        _seedY = null;
        _previewUrl = null;
        _error = null;
    }

    // FilePickerResult / ElementRect are shared public records in this namespace
    // (FilePickerInterop.cs) so render tests can reference the same type the JSInterop mock returns.
}
