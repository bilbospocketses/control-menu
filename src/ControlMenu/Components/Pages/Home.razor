@page "/"
@using ControlMenu.Components.Pages.HomeSections
@using ControlMenu.Modules.AndroidDevices.Services
@using ControlMenu.Modules.Cameras.Network
@using ControlMenu.Modules.Cameras.Services
@using ControlMenu.Services
@using ControlMenu.Services.Network
@implements IDisposable
@inject IConfigurationService Config
@inject IAdbService AdbService
@inject ICameraScanService CameraScanService
@inject SubnetDetectionClient SubnetDetector
@inject IScanLifecycleHandler AndroidHandler
@inject IDeviceChangeNotifier DeviceNotifier
@inject ICameraChangeNotifier CameraNotifier
@inject IDeviceService DeviceService
@inject ICameraService CameraService

<PageTitle>Control Menu</PageTitle>

@if (!_setupDone)
{
    <SetupWizard />
}
else
{
    <div class="home-root">
        <header class="home-header">
            <div class="home-brand">
                <img src="/icon-512.png" alt="Control Menu" class="home-logo" />
                <div class="home-titles">
                    <div class="home-title">Control Menu</div>
                    <div class="home-status">@StatusLine</div>
                </div>
            </div>
            <HomeScanBand AndroidRunning="_androidRunning"
                          CamerasRunning="_camerasRunning"
                          AllRunning="_allRunning"
                          OnScanAndroid="ScanAndroidAsync"
                          OnScanCameras="ScanCamerasAsync"
                          OnScanAll="ScanAllAsync" />
        </header>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="home-error alert alert-danger" role="alert">@_errorMessage</div>
        }

        <HomeDiscoveredAndroid HasScanned="_androidScanned" OnDeviceAdded="HandleStatusRefresh" />
        <HomeDiscoveredCameras HasScanned="_camerasScanned" OnCameraAdded="HandleStatusRefresh" />
        <HomeModuleTiles />
    </div>
}

@code {
    private bool _setupDone = true;
    private bool _androidScanned;
    private bool _camerasScanned;
    private bool _androidRunning;
    private bool _camerasRunning;
    private bool _allRunning;
    private DateTime? _lastScanUtc;
    private int _registeredDevicesCount;
    private int _registeredCamerasCount;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe BEFORE the initial load (Batch B convention).
        DeviceNotifier.Changed += HandleDeviceNotifierChanged;
        CameraNotifier.CamerasChanged += HandleCameraNotifierChanged;

        var flag = await Config.GetSettingAsync("setup-completed");
        if (flag != "true") _setupDone = false;

        await RefreshRegisteredCountsAsync();
    }

    internal string StatusLine
    {
        get
        {
            if (!_androidScanned && !_camerasScanned)
                return "Find devices and cameras on your network, then manage them.";
            var ago = _lastScanUtc.HasValue
                ? $" · last scan {(DateTime.UtcNow - _lastScanUtc.Value).TotalSeconds:F0}s ago"
                : "";
            var n = AndroidHandler.Discovered.Count;
            var m = CameraScanService.Hits.Count;
            var k = _registeredDevicesCount + _registeredCamerasCount;
            return $"{n} Android · {m} Cameras discovered · {k} registered{ago}";
        }
    }

    private async Task RefreshRegisteredCountsAsync()
    {
        try
        {
            var devices = await DeviceService.GetAllDevicesAsync();
            _registeredDevicesCount = devices.Count;
        }
        catch
        {
            _registeredDevicesCount = 0;
        }

        try
        {
            var cameras = await CameraService.GetAllAsync();
            _registeredCamerasCount = cameras.Count;
        }
        catch
        {
            _registeredCamerasCount = 0;
        }
    }

    private async void HandleDeviceNotifierChanged()
    {
        await RefreshRegisteredCountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleCameraNotifierChanged()
    {
        await RefreshRegisteredCountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ScanAndroidAsync()
    {
        if (_androidRunning) return;
        _androidRunning = true;
        try { await AdbService.ScanMdnsAsync(); }
        finally
        {
            _androidRunning = false;
            _androidScanned = true;
            _lastScanUtc = DateTime.UtcNow;
            StateHasChanged();
        }
    }

    private async Task ScanCamerasAsync()
    {
        if (_camerasRunning) return;
        _camerasRunning = true;
        var ranScan = false;
        try
        {
            // Mirror CameraSettings.QuickScan: detect subnet, parse, then run ONVIF-only scan.
            var detected = await SubnetDetector.DetectAsync();
            if (detected is null)
            {
                _errorMessage = "Could not auto-detect a network subnet — verify ws-scrcpy-web is running. Use Scan Network to enter a subnet manually.";
                return;
            }

            var parseResult = SubnetParser.Parse(detected.Cidr);
            if (!parseResult.IsSuccess || parseResult.Value is null)
            {
                _errorMessage = $"Auto-detected subnet '{detected.Cidr}' could not be parsed. Use Scan Network to enter a subnet manually.";
                return;
            }

            await CameraScanService.StartOnvifOnlyScanAsync(new[] { parseResult.Value });
            ranScan = true;
            _errorMessage = null;
        }
        finally
        {
            _camerasRunning = false;
            if (ranScan)
            {
                _camerasScanned = true;
                _lastScanUtc = DateTime.UtcNow;
            }
            StateHasChanged();
        }
    }

    private async Task ScanAllAsync()
    {
        if (_allRunning) return;
        _allRunning = true;
        var androidTask = _androidRunning ? Task.CompletedTask : ScanAndroidAsync();
        var camerasTask = _camerasRunning ? Task.CompletedTask : ScanCamerasAsync();
        try { await Task.WhenAll(androidTask, camerasTask); }
        finally
        {
            _allRunning = false;
            StateHasChanged();
        }
    }

    private async Task HandleStatusRefresh()
    {
        await RefreshRegisteredCountsAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        DeviceNotifier.Changed -= HandleDeviceNotifierChanged;
        CameraNotifier.CamerasChanged -= HandleCameraNotifierChanged;
    }
}
