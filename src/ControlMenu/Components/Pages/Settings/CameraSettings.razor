@page "/settings/cameras"
@using ControlMenu.Components.Shared.Cameras
@using ControlMenu.Components.Shared.Scanner
@using ControlMenu.Modules.Cameras.Entities
@using ControlMenu.Modules.Cameras.Network
@using ControlMenu.Modules.Cameras.Services
@using ControlMenu.Services.Network
@inject ICameraService CameraService
@inject ICameraScanService ScanService
@inject ICameraChangeNotifier ChangeNotifier
@implements IDisposable

<div class="settings-section">
    <h2>Cameras</h2>
    <p>Discover, register, and manage IP cameras. <strong>Scan Network</strong> runs ONVIF WS-Discovery + a TCP-554 sweep across configured subnets to find cameras on your LAN. <strong>Add Camera Manually</strong> opens a form for cameras that don't auto-discover.</p>

    <div class="toolbar">
        <button class="btn btn-primary" @onclick="OpenScanModal">
            <i class="bi bi-broadcast"></i> Scan Network
        </button>
        <button class="btn btn-secondary" @onclick="OpenManualAddModal">
            <i class="bi bi-plus-lg"></i> Add Camera Manually
        </button>
    </div>

    @if (_cameras.Count == 0)
    {
        <p style="color: var(--text-muted);">No cameras configured yet. Use "Scan Network" to discover cameras on your LAN.</p>
    }
    else
    {
        <table class="data-table data-table-fixed">
            <thead>
                <tr>
                    <th style="width:60px;">Status</th>
                    <th>Name</th>
                    <th style="width:160px;">Address</th>
                    <th>Mfr / Model</th>
                    <th style="width:70px;">ONVIF</th>
                    <th style="width:75px;">Enabled</th>
                    <th style="width:110px;">Last Seen</th>
                    <th style="width:140px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cam in _cameras)
                {
                    <tr>
                        <td><span class="status-dot @GetStatusClass(cam)"></span></td>
                        <td>@cam.Name</td>
                        <td>@cam.IpAddress:@cam.Port</td>
                        <td>@(cam.Manufacturer ?? "—") @(cam.Model ?? "")</td>
                        <td>@(cam.IsOnvif ? "✓" : "✗")</td>
                        <td>
                            <input type="checkbox" checked="@cam.Enabled"
                                   @onchange="@(e => ToggleEnabled(cam, e))" />
                        </td>
                        <td>@FormatLastSeen(cam.LastSeen)</td>
                        <td class="actions">
                            <button class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditModal(cam))">Edit</button>
                            <button class="btn btn-danger btn-sm" @onclick="@(() => ConfirmDelete(cam))">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="settings-section">
    <h2>Discovered on Network</h2>
    <p>ONVIF cameras and RTSP-only devices found by the latest scan. Enter credentials and click <strong>Add</strong> to register; <span style="color: var(--text-muted);">×</span> dismisses the row for this scan session.</p>

    <DiscoveredCamerasPanel OnCameraAdded="@RefreshCamerasAsync" />
</div>

@if (_scanModalOpen)
{
    <ScanNetworkModal SettingsKey="cameras-scan-subnets"
                      Title="Scan for cameras"
                      ScanInProgress="@(ScanService.Phase is ScanPhase.Scanning or ScanPhase.Draining)"
                      OnStart="OnScanStart"
                      OnClose="@(() => _scanModalOpen = false)" />
}
@if (_editTarget is not null)
{
    <EditCameraModal Camera="_editTarget" OnClosed="@OnEditClosed" />
}
@if (_addManualOpen)
{
    <AddTcpCameraModal Ip="" Port="554" OnClosed="@OnAddClosed" OnAdded="@RefreshCamerasAsync" />
}

@if (_showDeleteConfirm)
{
    <div class="dialog-overlay" @onclick="CloseDeleteConfirm">
        <div class="dialog" @onclick:stopPropagation="true">
            <h3>Delete Camera</h3>
            <p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="CloseDeleteConfirm">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")" style="margin-top:1rem;">
        @_message
    </div>
}

@code {
    private List<Camera> _cameras = new();
    private bool _scanModalOpen;
    private bool _addManualOpen;
    private Camera? _editTarget;
    private bool _showDeleteConfirm;
    private Camera? _deleteTarget;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        ChangeNotifier.CamerasChanged += OnCamerasChanged;
        await RefreshCamerasAsync();
    }

    private async Task RefreshCamerasAsync()
    {
        var fresh = await CameraService.GetAllAsync();
        _cameras = fresh.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCamerasChanged() => _ = RefreshCamerasAsync();

    private async Task ToggleEnabled(Camera cam, ChangeEventArgs e)
    {
        cam.Enabled = (bool)(e.Value ?? false);
        await CameraService.UpdateAsync(cam);
    }

    private void ConfirmDelete(Camera cam)
    {
        _deleteTarget = cam;
        _showDeleteConfirm = true;
    }

    private void CloseDeleteConfirm()
    {
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteTarget is not null)
        {
            await CameraService.DeleteAsync(_deleteTarget.Id);
            _showDeleteConfirm = false;
            _deleteTarget = null;
            await RefreshCamerasAsync();
            await ShowMessage("Camera deleted.");
        }
    }

    private void OpenScanModal() => _scanModalOpen = true;
    private void OpenManualAddModal() => _addManualOpen = true;
    private void OpenEditModal(Camera cam) => _editTarget = cam;
    private void OnEditClosed() => _editTarget = null;
    private void OnAddClosed() => _addManualOpen = false;

    private Task OnScanStart(IReadOnlyList<ParsedSubnet> subnets)
        => ScanService.StartScanAsync(subnets);

    private static string GetStatusClass(Camera cam)
    {
        if (!cam.Enabled) return "offline";
        if (cam.LastSeen is null) return "offline";
        var age = DateTime.UtcNow - cam.LastSeen.Value;
        if (age.TotalMinutes < 10) return "online";
        if (age.TotalHours < 24) return "stale";
        return "offline";
    }

    private static string FormatLastSeen(DateTime? lastSeen)
    {
        if (lastSeen is null) return "—";
        var ago = DateTime.UtcNow - lastSeen.Value;
        if (ago.TotalSeconds < 60) return "Just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private async Task ShowMessage(string message, bool isError = false)
    {
        _message = message;
        _messageIsError = isError;
        StateHasChanged();
        await Task.Delay(isError ? 10000 : 5000);
        _message = null;
        StateHasChanged();
    }

    public void Dispose() => ChangeNotifier.CamerasChanged -= OnCamerasChanged;
}
