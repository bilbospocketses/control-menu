@using ControlMenu.Components.Shared.Cameras
@using ControlMenu.Components.Shared.Scanner
@using ControlMenu.Modules.Cameras.Entities
@using ControlMenu.Modules.Cameras.Network
@using ControlMenu.Modules.Cameras.Services
@using ControlMenu.Services
@using ControlMenu.Services.Network
@inject ICameraService CameraService
@inject ICameraScanService ScanService
@inject ICameraChangeNotifier ChangeNotifier
@inject IConfigurationService Config
@inject IntervalChangeSignal IntervalSignal
@inject SubnetDetectionClient SubnetDetector
@implements IDisposable

<div class="settings-section">
    <h2>Camera Discovery</h2>
    <div class="form-group" style="margin-bottom:1.5rem;">
        <label>Liveness Interval (seconds)</label>
        <div style="display:flex; gap:0.5rem; align-items:center;">
            <input type="number" class="form-control" style="max-width:200px;" min="0" max="3600"
                   value="@_livenessInterval" @onchange="OnLivenessIntervalChanged" />
            <button class="btn btn-primary" @onclick="ScanNow">Scan Now</button>
            <button class="btn btn-primary" @onclick="RestoreDefaultInterval">Restore Default</button>
        </div>
        <div class="form-hint">How often to refresh camera Status &amp; Last Seen by probing each registered camera. Allowed: 0 (disabled) or 300–3600 seconds. Default 300.</div>
    </div>
</div>

<div class="settings-section">
    <h2>Cameras</h2>
    <p>Discover, register, and manage IP cameras. <strong>Quick Scan</strong> runs ONVIF WS-Discovery only against the auto-detected subnet — fast (~3-5s), finds ONVIF cameras with full metadata. <strong>Scan Network</strong> runs ONVIF + a TCP-554 sweep across user-selected subnets — slower, also finds non-ONVIF RTSP devices. <strong>Add Camera Manually</strong> opens a form for cameras that don't auto-discover.</p>

    <div class="toolbar">
        <button class="btn btn-primary" @onclick="OpenManualAddModal">
            <i class="bi bi-plus-lg"></i> Add Camera Manually
        </button>
        <button class="btn btn-secondary" @onclick="QuickScan" disabled="@_quickScanInProgress">
            <i class="bi bi-lightning-charge"></i> @(_quickScanInProgress ? "Scanning..." : "Quick Scan…")
        </button>
        <button class="btn btn-secondary" @onclick="OpenScanModal">
            <i class="bi bi-broadcast"></i> Scan Network…
        </button>
        @if (_cameras.Count > 0)
        {
            <button class="btn btn-danger" @onclick="ConfirmDeleteAll">
                <i class="bi bi-trash"></i> Delete All
            </button>
        }
    </div>

    @if (_cameras.Count == 0)
    {
        <p style="color: var(--text-muted);">No cameras configured yet. Use "Scan Network" to discover cameras on your LAN.</p>
    }
    else
    {
        <table class="data-table data-table-fixed">
            <thead>
                <tr>
                    <th>STATUS</th>
                    <th>CAM #</th>
                    <th>NAME</th>
                    <th>MFR / MODEL</th>
                    <th>ADDRESS</th>
                    <th>MAC ADDRESS</th>
                    <th>ENABLED</th>
                    <th>LAST SEEN</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cam in _cameras)
                {
                    <tr>
                        <td><span class="status-dot @GetStatusClass(cam)"></span></td>
                        <td>@(cam.CameraNumber?.ToString() ?? "—")</td>
                        <td>@cam.Name</td>
                        <td>@(cam.Manufacturer ?? "—") @(cam.Model ?? "")</td>
                        <td>@cam.IpAddress:@cam.Port</td>
                        <td>@(cam.MacAddress ?? "—")</td>
                        <td>
                            <input type="checkbox" checked="@cam.Enabled"
                                   @onchange="@(e => ToggleEnabled(cam, e))" />
                        </td>
                        <td>@FormatLastSeen(cam.LastSeen)</td>
                        <td class="actions">
                            <button class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditModal(cam))">Edit</button>
                            <button class="btn btn-danger btn-sm" @onclick="@(() => ConfirmDelete(cam))">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="settings-section">
    <h2>Discovered on Network</h2>
    <p>ONVIF cameras and RTSP-only devices found by the latest scan. Enter credentials and click <strong>Add</strong> to register; <span style="color: var(--text-muted);">×</span> dismisses the row for this scan session.</p>

    <DiscoveredCamerasPanel OnCameraAdded="@RefreshCamerasAsync" />
</div>

@if (_scanModalOpen)
{
    <ScanNetworkModal SettingsKey="cameras-scan-subnets"
                      Title="Scan for cameras"
                      ScanInProgress="@(ScanService.Phase is ScanPhase.Scanning or ScanPhase.Draining)"
                      OnStart="OnScanStart"
                      OnClose="@(() => _scanModalOpen = false)" />
}
@if (_editTarget is not null)
{
    <EditCameraModal Camera="_editTarget" OnClosed="@OnEditClosed" />
}
@if (_addManualOpen)
{
    <AddTcpCameraModal Ip="" Port="554" OnClosed="@OnAddClosed" OnAdded="@RefreshCamerasAsync" />
}

@if (_showDeleteConfirm)
{
    <div class="dialog-overlay" @onclick="CloseDeleteConfirm">
        <div class="dialog" @onclick:stopPropagation="true">
            <h3>Delete Camera</h3>
            <p>Are you sure you want to delete <strong>@_deleteTarget?.Name</strong>?</p>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="CloseDeleteConfirm">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteConfirmed">Delete</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteAllConfirm)
{
    <div class="dialog-overlay" @onclick="CloseDeleteAllConfirm">
        <div class="dialog" @onclick:stopPropagation="true">
            <h3>Delete all cameras?</h3>
            <p>All @_cameras.Count configured cameras will be removed and their credentials wiped. This cannot be undone.</p>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="CloseDeleteAllConfirm">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteAllConfirmedAsync">Delete All</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")" style="margin-top:1rem;">
        @_message
    </div>
}

@code {
    private List<Camera> _cameras = new();
    private bool _scanModalOpen;
    private bool _addManualOpen;
    private Camera? _editTarget;
    private bool _showDeleteConfirm;
    private Camera? _deleteTarget;
    private bool _showDeleteAllConfirm;
    private string? _message;
    private bool _messageIsError;
    private bool _quickScanInProgress;
    private IDisposable? _scanSubscription;
    private const int DefaultLivenessInterval = 300;
    private int _livenessInterval = DefaultLivenessInterval;

    protected override async Task OnInitializedAsync()
    {
        ChangeNotifier.CamerasChanged += OnCamerasChanged;
        _scanSubscription = ScanService.Subscribe(OnScanEvent);
        var interval = await Config.GetSettingAsync("cameras-liveness-interval-seconds", "cameras");
        if (int.TryParse(interval, out var parsed))
            _livenessInterval = parsed;
        await RefreshCamerasAsync();
    }

    private void OnScanEvent(CameraScanEvent ev)
    {
        try
        {
            _ = InvokeAsync(() =>
            {
                switch (ev)
                {
                    case CameraScanStartedEvent:
                        _quickScanInProgress = true;
                        break;
                    case CameraScanCompletedEvent or CameraScanCancelledEvent:
                        _quickScanInProgress = false;
                        break;
                }
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Component disposed mid-event; subscription already removed in Dispose().
        }
    }

    private async Task QuickScan()
    {
        _message = null;
        _messageIsError = false;
        StateHasChanged();

        var detected = await SubnetDetector.DetectAsync();
        if (detected is null)
        {
            await ShowMessage("Could not auto-detect a network subnet — verify ws-scrcpy-web is running. Use Scan Network to enter a subnet manually.", true);
            return;
        }

        var parseResult = SubnetParser.Parse(detected.Cidr);
        if (!parseResult.IsSuccess || parseResult.Value is null)
        {
            await ShowMessage($"Auto-detected subnet '{detected.Cidr}' could not be parsed. Use Scan Network to enter a subnet manually.", true);
            return;
        }

        await ScanService.StartOnvifOnlyScanAsync(new[] { parseResult.Value });
    }

    private async Task OnLivenessIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val) && (val == 0 || (val >= 300 && val <= 3600)))
        {
            _livenessInterval = val;
            await Config.SetSettingAsync("cameras-liveness-interval-seconds", val.ToString(), "cameras");
            IntervalSignal.Trigger(IntervalChangeSignal.CameraLiveness);
            await ShowMessage("Saved.");
        }
        else
        {
            await ShowMessage("Must be 0 (disabled) or between 300 and 3600 seconds.", true);
        }
    }

    private async Task RestoreDefaultInterval()
    {
        _livenessInterval = DefaultLivenessInterval;
        await Config.SetSettingAsync("cameras-liveness-interval-seconds", DefaultLivenessInterval.ToString(), "cameras");
        IntervalSignal.Trigger(IntervalChangeSignal.CameraLiveness);
        await ShowMessage($"Restored default ({DefaultLivenessInterval}s).");
    }

    private async Task ScanNow()
    {
        IntervalSignal.Trigger(IntervalChangeSignal.CameraLiveness);
        await ShowMessage("Liveness scan triggered.");
    }

    private async Task RefreshCamerasAsync()
    {
        var fresh = await CameraService.GetAllAsync();
        _cameras = fresh
            .OrderBy(c => c.CameraNumber ?? int.MaxValue)
            .ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCamerasChanged() => _ = RefreshCamerasAsync();

    private async Task ToggleEnabled(Camera cam, ChangeEventArgs e)
    {
        cam.Enabled = (bool)(e.Value ?? false);
        await CameraService.UpdateAsync(cam);
    }

    private void ConfirmDelete(Camera cam)
    {
        _deleteTarget = cam;
        _showDeleteConfirm = true;
    }

    private void CloseDeleteConfirm()
    {
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteTarget is not null)
        {
            await CameraService.DeleteAsync(_deleteTarget.Id);
            _showDeleteConfirm = false;
            _deleteTarget = null;
            await RefreshCamerasAsync();
            await ShowMessage("Camera deleted.");
        }
    }

    private void ConfirmDeleteAll() => _showDeleteAllConfirm = true;
    private void CloseDeleteAllConfirm() => _showDeleteAllConfirm = false;

    private async Task DeleteAllConfirmedAsync()
    {
        _showDeleteAllConfirm = false;
        await CameraService.DeleteAllAsync();
        // RefreshCamerasAsync fires automatically via ICameraChangeNotifier subscription
    }

    private void OpenScanModal() => _scanModalOpen = true;
    private void OpenManualAddModal() => _addManualOpen = true;
    private void OpenEditModal(Camera cam) => _editTarget = cam;
    private void OnEditClosed() => _editTarget = null;
    private void OnAddClosed() => _addManualOpen = false;

    private Task OnScanStart(IReadOnlyList<ParsedSubnet> subnets)
        => ScanService.StartScanAsync(subnets);

    private static string GetStatusClass(Camera cam)
    {
        if (!cam.Enabled) return "offline";
        if (cam.LastSeen is null) return "offline";
        var age = DateTime.UtcNow - cam.LastSeen.Value;
        if (age.TotalMinutes < 10) return "online";
        if (age.TotalHours < 24) return "stale";
        return "offline";
    }

    private static string FormatLastSeen(DateTime? lastSeen)
    {
        if (lastSeen is null) return "—";
        var ago = DateTime.UtcNow - lastSeen.Value;
        if (ago.TotalSeconds < 60) return "Just now";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        if (ago.TotalHours < 24) return $"{(int)ago.TotalHours}h ago";
        return $"{(int)ago.TotalDays}d ago";
    }

    private async Task ShowMessage(string message, bool isError = false)
    {
        _message = message;
        _messageIsError = isError;
        StateHasChanged();
        await Task.Delay(isError ? 10000 : 5000);
        _message = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        ChangeNotifier.CamerasChanged -= OnCamerasChanged;
        _scanSubscription?.Dispose();
    }
}
