@using ControlMenu.Services
@using ControlMenu.Modules.Jellyfin.Services
@using ControlMenu.Components.Shared
@implements IDisposable

<SettingsSection Title="Docker Compose">
    <div class="settings-section-intro">
        Point Control Menu to your Jellyfin docker-compose.yml to auto-detect container name and database path.
    </div>

    <SettingsGrid>
        <SettingsGridCell FullRow="true">
            <Label>Compose File Path</Label>
            <ChildContent>
                <div style="display:flex;gap:8px;align-items:center;">
                    <input type="text" class="form-control" @bind="_composePath" placeholder="e.g., D:\DockerData\jellyfin\docker-compose.yml" style="flex:1;" />
                    <button class="btn btn-primary" @onclick="SaveAndParse" disabled="@_parsing">
                        <i class="bi bi-arrow-repeat"></i> @(_parsing ? "Parsing..." : "Save & Parse")
                    </button>
                </div>

                @if (_parseResult is not null)
                {
                    @if (_parseResult.ErrorMessage is not null)
                    {
                        <div class="alert alert-danger" style="margin-top:8px;">
                            <i class="bi bi-exclamation-triangle"></i> @_parseResult.ErrorMessage
                        </div>
                    }
                    else
                    {
                        <table class="data-table" style="max-width:600px;margin-top:8px;">
                            <tr>
                                <td><strong>Container Name</strong></td>
                                <td><code>@(_parseResult.ContainerName ?? "—")</code></td>
                            </tr>
                            <tr>
                                <td><strong>Database Path</strong></td>
                                <td><code>@(_parseResult.DbPath ?? "—")</code></td>
                            </tr>
                        </table>
                    }
                }
            </ChildContent>
        </SettingsGridCell>
    </SettingsGrid>
</SettingsSection>

<SettingsSection Title="Jellyfin API">
    <SettingsGrid>
        <SettingsGridCell>
            <Label>Base URL</Label>
            <ChildContent>
                <input class="form-control" value="@_baseUrl" @onchange="SaveBaseUrl" placeholder="http://127.0.0.1:8096" />
            </ChildContent>
        </SettingsGridCell>

        <SettingsGridCell>
            <Label>API Key</Label>
            <ChildContent>
                <input type="password" class="form-control" value="@_apiKey" @onchange="SaveApiKey" />
            </ChildContent>
        </SettingsGridCell>

        <SettingsGridCell>
            <Label>User ID</Label>
            <ChildContent>
                <input class="form-control" value="@_userId" @onchange="SaveUserId" />
            </ChildContent>
            <Hint>Jellyfin user ID for API calls (used by Cast &amp; Crew updates).</Hint>
        </SettingsGridCell>

        <SettingsGridCell />
    </SettingsGrid>
</SettingsSection>

<SettingsSection Title="Logging, Backup &amp; Retention">
    <table class="data-table settings-section-table" style="width:100%;">
        <thead>
            <tr>
                <th style="text-align:left;width:130px;">Setting</th>
                <th style="text-align:left;">Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Backups</strong></td>
                <td>
                    <input class="form-control" @bind="_backupDirectory" @bind:event="onchange" @onblur="SaveBackupDirectory" />
                    <span style="font-size:11px;color:var(--text-secondary);margin-top:4px;display:block;">@_backupCount files, @FormatSize(_backupSize)</span>
                </td>
            </tr>
            <tr>
                <td><strong>Logs</strong></td>
                <td>
                    <input class="form-control" @bind="_logDirectory" @bind:event="onchange" @onblur="SaveLogDirectory" />
                    <span style="font-size:11px;color:var(--text-secondary);margin-top:4px;display:block;">@_logCount files</span>
                </td>
            </tr>
            <tr>
                <td><strong>Retention</strong></td>
                <td>
                    <input type="number" class="form-control" @bind="_retentionDays" @bind:event="onchange" @onblur="SaveRetention" min="1" max="365" style="width:120px;display:inline-block;" />
                    <span style="margin-left:8px;color:var(--text-secondary);">days</span>
                </td>
            </tr>
        </tbody>
    </table>
</SettingsSection>

<SettingsSection Title="Cast &amp; Crew Notifications">
    <SettingsGrid>
        <SettingsGridCell>
            <Label>Notification Email</Label>
            <ChildContent>
                <input type="email" class="form-control" value="@_castCrewEmail" @onchange="SaveCastCrewEmail"
                       placeholder="Uses default from General if blank" />
            </ChildContent>
            <Hint>Receives completion alerts for Cast &amp; Crew updates. Leave blank to use the default notification email from General settings.</Hint>
        </SettingsGridCell>

        <SettingsGridCell />
    </SettingsGrid>
</SettingsSection>

@if (Notice.IsVisible)
{
    <div class="alert @Notice.CssClass" style="margin-top:1rem;">
        @Notice.Message
    </div>
}

@code {
    private TransientNotice? _noticeBacking;
    private TransientNotice Notice => _noticeBacking ??= new(() => InvokeAsync(StateHasChanged));

    [Inject] private IConfigurationService Config { get; set; } = default!;
    [Inject] private IJellyfinService JellyfinService { get; set; } = default!;
    [Inject] private IJellyfinDirectoryResolver DirectoryResolver { get; set; } = default!;

    private string _composePath = "";
    private string _baseUrl = "";
    private string _apiKey = "";
    private string _userId = "";
    private string _castCrewEmail = "";
    private int _retentionDays = 5;
    private string _backupDirectory = "";
    private string _logDirectory = "";
    private bool _parsing;
    private ComposeParseResult? _parseResult;
    private int _backupCount;
    private long _backupSize;
    private int _logCount;

    protected override async Task OnInitializedAsync()
    {
        _composePath = await Config.GetSettingAsync("jellyfin-compose-path") ?? "";
        _baseUrl = await Config.GetSettingAsync("jellyfin-base-url") ?? "http://127.0.0.1:8096";
        _apiKey = await Config.GetSecretAsync("jellyfin-api-key") ?? "";
        _userId = await Config.GetSettingAsync("jellyfin-user-id") ?? "";
        _castCrewEmail = await Config.GetSettingAsync("jellyfin-castcrew-notify-email") ?? "";
        var retStr = await Config.GetSettingAsync("jellyfin-backup-retention-days");
        _retentionDays = int.TryParse(retStr, out var d) ? d : 5;
        _backupDirectory = await DirectoryResolver.GetBackupDirectoryAsync();
        _logDirectory = await DirectoryResolver.GetLogDirectoryAsync();

        RefreshDirectoryStats();

        if (!string.IsNullOrEmpty(_composePath))
        {
            _parseResult = await JellyfinService.ParseComposeFileAsync();
        }
    }

    private async Task SaveAndParse()
    {
        _parsing = true;
        Notice.Clear();
        StateHasChanged();

        await Config.SetSettingAsync("jellyfin-compose-path", _composePath);
        _parseResult = await JellyfinService.ParseComposeFileAsync();

        var isError = _parseResult.ErrorMessage is not null;
        var msg = _parseResult.ErrorMessage is null
            ? "Compose file parsed. Container name and database path configured."
            : _parseResult.ErrorMessage;
        ShowMessage(msg, isError);
        _parsing = false;
    }

    private async Task SaveBaseUrl(ChangeEventArgs e)
    {
        _baseUrl = e.Value?.ToString() ?? "";
        await Config.SetSettingAsync("jellyfin-base-url", _baseUrl);
        ShowMessage("Saved.", false);
    }

    private async Task SaveApiKey(ChangeEventArgs e)
    {
        _apiKey = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(_apiKey))
        {
            await Config.SetSecretAsync("jellyfin-api-key", _apiKey);
            ShowMessage("Saved.", false);
        }
        else
        {
            await Config.DeleteSettingAsync("jellyfin-api-key");
            ShowMessage("API key cleared.", false);
        }
    }

    private async Task SaveUserId(ChangeEventArgs e)
    {
        _userId = e.Value?.ToString() ?? "";
        await Config.SetSettingAsync("jellyfin-user-id", _userId);
        ShowMessage("Saved.", false);
    }

    private async Task SaveCastCrewEmail(ChangeEventArgs e)
    {
        _castCrewEmail = e.Value?.ToString() ?? "";
        await Config.SetSettingAsync("jellyfin-castcrew-notify-email", _castCrewEmail);
        ShowMessage("Saved.", false);
    }

    private async Task SaveRetention()
    {
        await Config.SetSettingAsync("jellyfin-backup-retention-days", _retentionDays.ToString());
        ShowMessage($"Backup retention set to {_retentionDays} days.", false);
    }

    private async Task SaveBackupDirectory()
    {
        var newPath = (_backupDirectory ?? "").Trim();
        if (string.IsNullOrEmpty(newPath))
        {
            ShowMessage("Backup directory cannot be empty.", true);
            return;
        }

        var oldPath = await DirectoryResolver.GetBackupDirectoryAsync();
        if (string.Equals(oldPath, newPath, StringComparison.OrdinalIgnoreCase))
        {
            ShowMessage("Backups path saved.", false);
            return;
        }

        // The whole directory, not just *.db: media-cards/ used to stay behind, where the Media
        // Cards page's Restore -- which reads the current path -- could no longer find it.
        var migration = await DirectoryResolver.MigrateBackupsAsync(oldPath, newPath);
        if (!migration.Success)
        {
            ShowMessage($"Could not save: {migration.ErrorMessage}", true);
            return;
        }

        await Config.SetSettingAsync("jellyfin-backup-directory", newPath);
        RefreshDirectoryStats();
        ShowMessage(BuildMigrationMessage("Backups", migration), migration.FailedCount > 0);
    }

    private async Task SaveLogDirectory()
    {
        var newPath = (_logDirectory ?? "").Trim();
        if (string.IsNullOrEmpty(newPath))
        {
            ShowMessage("Log directory cannot be empty.", true);
            return;
        }

        var oldPath = await DirectoryResolver.GetLogDirectoryAsync();
        if (string.Equals(oldPath, newPath, StringComparison.OrdinalIgnoreCase))
        {
            ShowMessage("Logs path saved.", false);
            return;
        }

        var migration = await DirectoryResolver.MigrateFilesAsync(oldPath, newPath, "*.log");
        if (!migration.Success)
        {
            ShowMessage($"Could not save: {migration.ErrorMessage}", true);
            return;
        }

        await Config.SetSettingAsync("jellyfin-log-directory", newPath);
        RefreshDirectoryStats();
        ShowMessage(BuildMigrationMessage("Logs", migration), migration.FailedCount > 0);
    }

    private static string BuildMigrationMessage(string label, DirectoryMigrationResult result)
    {
        if (result.MovedCount == 0 && result.FailedCount == 0)
            return $"{label} path saved.";
        if (result.FailedCount == 0)
            return $"{label} path saved. Moved {result.MovedCount} files.";
        return $"{label} path saved. Moved {result.MovedCount} files; {result.FailedCount} could not be moved (in use): {string.Join(", ", result.FailedFiles)}. Retry the Save to migrate them.";
    }

    // Sync wrapper kept so the existing fire-and-forget call sites are unchanged; the work runs in
    // a try/catch'd Task so a directory-IO failure (UnauthorizedAccess, a TOCTOU delete, a bad path)
    // can never escape as an unobserved async-void exception and tear down the circuit.
    private void RefreshDirectoryStats() => _ = RefreshDirectoryStatsAsync();

    private async Task RefreshDirectoryStatsAsync()
    {
        try
        {
            // Database backups plus the card backups under media-cards/, which a *.db glob
            // here used to leave out of both the count and the size.
            var stats = DirectoryResolver.GetBackupStats(await DirectoryResolver.GetBackupDirectoryAsync());
            _backupCount = stats.FileCount;
            _backupSize = stats.TotalBytes;

            var logDir = await DirectoryResolver.GetLogDirectoryAsync();
            _logCount = Directory.Exists(logDir) ? Directory.GetFiles(logDir, "*.log").Length : 0;
        }
        catch
        {
            _backupCount = 0;
            _backupSize = 0;
            _logCount = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ShowMessage(string msg, bool isError) =>
        Notice.Show(msg, isError ? "alert-danger" : "alert-success", dismissMs: isError ? 10000 : 5000);

    private static string FormatSize(long bytes) => Services.FormatHelper.FormatSize(bytes);

    public void Dispose() => _noticeBacking?.Dispose();
}
