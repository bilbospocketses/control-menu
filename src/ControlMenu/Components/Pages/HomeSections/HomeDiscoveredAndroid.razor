@* HomeDiscoveredAndroid.razor *@
@using ControlMenu.Components.Shared.Scanner
@using ControlMenu.Data.Entities
@using ControlMenu.Services
@using ControlMenu.Services.Network
@inject IScanLifecycleHandler Handler
@inject IDeviceChangeNotifier Notifier
@inject IDeviceService DeviceService
@inject IDeviceRegistrationService DeviceRegistration
@implements IDisposable

@* Section ALWAYS renders now: cold and post-scan-empty both show the outlined
   placeholder card. HasScanned remains a parameter for API symmetry with
   HomeDiscoveredCameras (Home.razor still tracks _androidScanned for the
   status-line tagline), but no longer keys the section's visibility. *@
<section class="home-disc-section">
    <div class="home-disc-header">
        <span class="home-disc-label">DISCOVERED — ANDROID</span>
        <span class="home-disc-count home-disc-count-android">@Handler.Discovered.Count</span>
    </div>
    @if (Handler.Discovered.Count == 0)
    {
        <div class="home-disc-placeholder">
            No Android devices found on the last scan. Run a scan to look for Androids on your network.
        </div>
    }
    else
    {
        <DiscoveredPanel Discovered="Handler.Discovered"
                         Registered="_devices"
                         OnAdd="HandleInlineAdd"
                         OnDismiss="HandleDismiss" />
    }
</section>

@code {
    [Parameter] public bool HasScanned { get; set; }
    [Parameter] public EventCallback OnDeviceAdded { get; set; }

    private IReadOnlyList<Device> _devices = Array.Empty<Device>();

    protected override async Task OnInitializedAsync()
    {
        Notifier.Changed += HandleNotifierChanged;
        _devices = await DeviceService.GetAllDevicesAsync();
    }

    private async void HandleNotifierChanged()
    {
        _devices = await DeviceService.GetAllDevicesAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Delegates the shared inline-add body (normalize MAC, persist, store optional PIN,
    // drop the claimed row from Handler.Discovered) to IDeviceRegistrationService, then
    // refreshes the local list and bubbles OnDeviceAdded so Home.razor updates its status.
    private async Task HandleInlineAdd(InlineAddPayload payload)
    {
        await DeviceRegistration.RegisterDiscoveredAsync(payload);
        _devices = await DeviceService.GetAllDevicesAsync();
        await OnDeviceAdded.InvokeAsync();
    }

    private void HandleDismiss(DiscoveredDevice d) => Handler.Dismiss(d);

    public void Dispose()
    {
        Notifier.Changed -= HandleNotifierChanged;
    }
}
