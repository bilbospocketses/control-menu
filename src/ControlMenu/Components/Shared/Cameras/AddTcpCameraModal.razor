@using ControlMenu.Modules.Cameras.Network
@using ControlMenu.Modules.Cameras.Entities
@using ControlMenu.Modules.Cameras.Services
@inject IRtspProbeClient RtspClient
@inject ICameraService CameraService

<div class="dialog-overlay" @onclick="@CloseAsync">
    <div class="dialog add-tcp-dialog" @onclick:stopPropagation="true">
        <div class="dialog-header">
            <h3>Add RTSP camera manually</h3>
        </div>
        <div class="form-body">
            <div class="form-row form-row-2col">
                <label class="form-field">
                    <span>IP</span>
                    <input type="text" class="form-control" @bind="_ip" placeholder="e.g. 192.168.1.50" />
                </label>
                <label class="form-field">
                    <span>Port</span>
                    <input type="number" class="form-control" @bind="_port" min="1" max="65535" />
                </label>
            </div>
            <label class="form-field">
                <span>Display name</span>
                <input type="text" class="form-control" @bind="_name" />
            </label>
            <label class="form-field">
                <span>Manufacturer</span>
                <input type="text" class="form-control" @bind="_manufacturer" placeholder="optional" />
            </label>
            <div class="form-row form-row-2col">
                <label class="form-field">
                    <span>Username</span>
                    <input type="text" class="form-control" @bind="_username" />
                </label>
                <label class="form-field">
                    <span>Password</span>
                    <input type="password" class="form-control" @bind="_password" />
                </label>
            </div>
            <label class="form-field">
                <span>Stream path</span>
                <input list="stream-path-hints" class="form-control" @bind="_streamPath" />
                <datalist id="stream-path-hints">
                    <option value="/Streaming/Channels/101">Hikvision</option>
                    <option value="/cam/realmonitor?channel=1&subtype=0">Dahua</option>
                    <option value="/h264Preview_01_main">Reolink</option>
                </datalist>
            </label>
            @if (_error is not null)
            {
                <div class="error-banner">&#9888; @_error</div>
            }
        </div>
        <div class="dialog-actions">
            <button class="btn btn-secondary" @onclick="@CloseAsync">Cancel</button>
            <button class="btn btn-primary" @onclick="@SubmitAsync" disabled="@_busy">@(_busy ? "Validating..." : "Add")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Ip { get; set; } = "";
    [Parameter] public int Port { get; set; } = 554;
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    private string _ip = "";
    private int _port = 554;
    private string _name = "";
    private string _manufacturer = "";
    private string _username = "";
    private string _password = "";
    private string _streamPath = "";
    private string? _error;
    private bool _busy;

    protected override void OnParametersSet()
    {
        _ip = Ip;
        _port = Port;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_ip)) { _error = "IP address required"; return; }
        if (_port < 1 || _port > 65535) { _error = "Port must be between 1 and 65535"; return; }
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Display name required"; return; }
        if (string.IsNullOrWhiteSpace(_streamPath)) { _error = "Stream path required"; return; }

        _busy = true;
        StateHasChanged();
        try
        {
            var encUser = Uri.EscapeDataString(_username);
            var encPass = Uri.EscapeDataString(_password);
            var rtspUrl = $"rtsp://{encUser}:{encPass}@{_ip}:{_port}{_streamPath}";

            var result = await RtspClient.DescribeAsync(rtspUrl, TimeSpan.FromSeconds(5), default);
            if (!result.Success)
            {
                _error = $"RTSP DESCRIBE failed: {result.StatusCode} {result.StatusReason}".TrimEnd();
                return;
            }

            var cam = new Camera
            {
                Name = _name,
                IpAddress = _ip,
                Port = _port,
                Manufacturer = string.IsNullOrWhiteSpace(_manufacturer) ? null : _manufacturer,
                RtspStreamUrl = $"rtsp://{_ip}:{_port}{_streamPath}",
                IsOnvif = false,
                Enabled = true,
            };
            await CameraService.AddAsync(cam, _username, _password);
            await OnAdded.InvokeAsync();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _error = $"Add failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task CloseAsync() => await OnClosed.InvokeAsync();
}
